---
import Logo from "./Logo.astro";
import Toggles from "./Toggles.astro";

const links = [
  { href: "#install", label: "Install" },
  { href: "#principles", label: "Principles" },
  { href: "#ways-in", label: "Renderers" },
  { href: "#gallery", label: "Gallery" },
  { href: "https://github.com/boligolov/asciicharts", label: "GitHub" },
];
---

<header class="nav">
  <a class="nav-brand" href="#top">
    <span class="glyphs"><Logo /></span> ASCIICHARTS
  </a>
  <nav class="nav-links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <div class="nav-controls">
    <Toggles />
  </div>
</header>

