---
const features = [
  {
    title: "Two, byte for byte",
    body: "Go — one static binary for the command line, a library, an MCP server — and Python, one standard-library file. Both pass the conformance suite and agree on tens of thousands of random specs.",
  },
  {
    title: "Deterministic",
    body: "A pure function of the spec: no clock, no randomness, no terminal probing. Same input, same bytes — safe to snapshot, diff and commit.",
  },
  {
    title: "Built to be called by machines",
    body: 'Strict, bounded input and one-line errors that say what to fix — error: row 3, column "v" is not a number: "n/a" — so a script or an agent can correct itself. Text from untrusted data can\'t smuggle escape codes into a terminal.',
  },
  {
    title: "Gets the hard cases right",
    body: "Negative values grow both ways from a zero line, stacked ones too. Dirty CSV numbers ($1,200, 12%, decimal commas) are parsed, not silently dropped. Labels in any script — 東京, été, 🍕 — keep the frame straight.",
  },
  {
    title: "Font-safe by default",
    body: "Whole █ blocks, glyphs even Consolas has, a pure-ASCII mode for terminals and mail. No ragged right edges.",
  },
  {
    title: "No side effects",
    body: "The renderer writes nothing and opens no sockets. The server is stateless and records nothing.",
  },
];
---

<section class="section" id="why">
  <div class="wrap">
    <p class="section-kicker">// the reference implementations</p>
    <div class="grid">
      {
        features.map((f) => (
          <div class="grid-item">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
