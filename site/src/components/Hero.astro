---
import Chart from "./Chart.astro";
import Install from "./Install.astro";
---

<section class="hero" id="top">
  <div class="wrap">
    <h1 class="hero-title pixel-heading">ASCIICHARTS</h1>
    <p class="hero-tagline pixel-heading" style="font-size: 14px; color: var(--fg);">
      An agent skill for charts made of text — drawn right
    </p>
    <p class="hero-pitch">
      Ask Claude for a chart in a reply, a PR, a commit message or a terminal: bars, lines, sparklines,
      histograms, pies, heatmaps — <strong>lengths that match the values, frames that stay straight in any
      font, series you can tell apart without color.</strong> It draws them by hand from the principles, or
      renders them exactly when a renderer is at hand.
    </p>

    <Install />

    <div class="hero-ctas">
      <a class="btn btn-secondary pixel-corners" href="#principles">
        THE PRINCIPLES BEHIND IT ▸
      </a>
      <a class="btn btn-secondary pixel-corners" href="https://github.com/boligolov/asciicharts">
        GITHUB
      </a>
    </div>

    <div class="hero-chart">
      <Chart id="hero" kind="hbar · grouped" />
      <p class="hero-chart-caption">
        Real <code>render_chart()</code> output, frame and title included — flip{" "}
        <strong>MONO / COLOR</strong> or <strong>BLACK / WHITE</strong> right on the chart.
      </p>
    </div>
  </div>
</section>
