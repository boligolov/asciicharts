---
const ways = [
  {
    title: "Agent skill",
    for_: "Claude Code and other agents",
    body: "Teaches an agent to draw a correct text chart by hand — lengths computed, rows counted, then checked — and to use a renderer when there is one.",
    code: [
      ['/plugin marketplace add boligolov/asciicharts'],
      ['/plugin install asciicharts@asciicharts'],
    ],
  },
  {
    title: "Command line",
    for_: "scripts, CI, terminals",
    body: "One static binary (Go), or one Python file. A JSON spec or a CSV file in, a chart out.",
    code: [
      ['<span class="tok-kw">$</span> asciicharts --csv latency.csv \\'],
      ["    --chart hbar --sort -p99 --limit 3"],
    ],
  },
  {
    title: "Library",
    for_: "Go and Python programs",
    body: "The same renderer in your code: a pure function from a spec to a string, standard library only.",
    code: [
      ['<span class="tok-kw">&gt;&gt;&gt;</span> from asciicharts import render_chart'],
      ['<span class="tok-kw">$</span> go get github.com/boligolov/asciicharts/go'],
    ],
  },
  {
    title: "MCP server",
    for_: "any MCP client, one shared deployment",
    body: "Two tools: list_charts (the catalogue) and render_chart. stdio or stateless streamable HTTP. One static Go binary.",
    code: [
      ['<span class="tok-kw">$</span> go install github.com/boligolov/asciicharts/go/cmd/asciicharts-mcp@latest'],
      ['<span class="tok-kw">$</span> claude mcp add asciicharts -- asciicharts-mcp'],
    ],
  },
];
---

<section class="section" id="ways-in">
  <div class="wrap">
    <p class="section-kicker">// four ways in</p>
    <h2 class="section-title pixel-heading" style="font-size:20px;">Pick the one that fits</h2>
    <div class="ways">
      {
        ways.map((w) => (
          <div class="way-card">
            <div class="way-card-body">
              <h3>{w.title}</h3>
              <p style="color: var(--accent-2); font-size: 12px; margin-bottom: 10px;">{w.for_}</p>
              <p>{w.body}</p>
            </div>
            <div class="code-block">
              {w.code.map((line) => (
                <div set:html={line[0]} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
