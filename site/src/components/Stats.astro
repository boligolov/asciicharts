---
const stats = [
  { value: "v1.3", label: "PRINCIPLES" },
  { value: "455", label: "CONFORMANCE CASES" },
  { value: "2", label: "IMPLEMENTATIONS" },
  { value: "12", label: "CHART TYPES" },
];
---

<section class="band">
  <div class="wrap">
    <div class="stat-grid">
      {
        stats.map((s) => (
          <div>
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
