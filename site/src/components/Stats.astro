---
const stats = [
  { value: "1", label: "FILE" },
  { value: "0", label: "DEPENDENCIES" },
  { value: "600+", label: "TESTS" },
  { value: "12", label: "CHART TYPES" },
];
---

<section class="band">
  <div class="wrap">
    <div class="stat-grid">
      {
        stats.map((s) => (
          <div>
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
