---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-row">
      <span class="nav-brand" style="font-size: 12px;">
        <span class="glyphs"><Logo /></span> ASCIICHARTS
      </span>
      <div class="footer-links">
        <a href="https://github.com/boligolov/asciicharts">GitHub</a>
        <a href="https://github.com/boligolov/asciicharts/blob/master/docs/gallery.md">Gallery</a>
        <a href="https://github.com/boligolov/asciicharts/blob/master/skills/asciicharts/SKILL.md">Skill</a>
        <a href="https://github.com/boligolov/asciicharts/blob/master/server/README.md">MCP server</a>
        <a href="https://github.com/boligolov/asciicharts/blob/master/LICENSE">MIT license</a>
      </div>
    </div>
    <p class="footer-note">
      Every chart on this page is the real output of <code>render_chart()</code>, generated by <code>site/scripts/render_examples.py</code> from the same specs shown in the README — not hand-drawn. © {year} asciicharts contributors.
    </p>
  </div>
</footer>
