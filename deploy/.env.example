# Copy to deploy/.env (next to the compose files) and edit:
#   cp deploy/.env.example deploy/.env
#
# docker-compose.yml (local development) works without any of this; the defaults
# below are baked into it. docker-compose.prod.yml requires only DOMAIN.

# --- production ---------------------------------------------------------------
# Public host name Caddy serves and gets a certificate for. Its DNS record must
# point at this machine. (For a local trial use `localhost`: Caddy then uses its
# own internal CA.)
DOMAIN=charts.example.com
# Optional: use a prebuilt image from your registry instead of building here.
# IMAGE=registry.example.com/asciicharts:1.0.0

# --- usage statistics (OFF by default) ----------------------------------------
# Anonymous counters (chart type, style, size buckets, success/failure; never your
# data) in Postgres. To enable in production, uncomment all three lines:
# ASCIICHARTS_STATS=on
# COMPOSE_PROFILES=stats
# POSTGRES_PASSWORD=change-me      # e.g. `openssl rand -hex 24`; goes into a URL, so
#                                  # prefer letters and digits (percent-encode the rest)
# The local dev stack (docker-compose.yml) has statistics on by default.
POSTGRES_USER=asciicharts
POSTGRES_DB=asciicharts
