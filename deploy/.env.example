# Copy to deploy/.env (next to the compose files) and edit:
#   cp deploy/.env.example deploy/.env
#
# docker-compose.yml (local run) needs none of this. docker-compose.prod.yml requires only DOMAIN.

# Public host name Caddy serves and gets a certificate for. Its DNS record must point at this machine.
# (For a local trial use `localhost`: Caddy then uses its own internal CA.)
DOMAIN=charts.example.com
# Optional: use a prebuilt image from your registry instead of building here.
# IMAGE=registry.example.com/asciicharts:1.0.0
